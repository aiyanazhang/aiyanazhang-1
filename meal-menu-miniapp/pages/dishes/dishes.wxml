<view class="container">
  <view class="header">
    <button class="add-btn" bindtap="showAddForm">+ 添加自定义菜品</button>
  </view>

  <view class="dish-categories">
    <view class="category-section">
      <view class="category-title">
        <text class="icon">🍽️</text>
        <text>菜品 ({{dishes.filter(d => d.category === 'dish').length}})</text>
      </view>
      <view class="dish-grid">
        <view class="dish-card" wx:for="{{dishes}}" wx:key="id" wx:if="{{item.category === 'dish'}}">
          <text class="dish-name">{{item.name}}</text>
          <text class="dish-tag" wx:if="{{item.is_preset}}">预设</text>
          <text class="dish-tag custom" wx:else>自定义</text>
        </view>
      </view>
      <view class="empty-hint" wx:if="{{dishes.filter(d => d.category === 'dish').length === 0}}">
        <text>暂无菜品</text>
      </view>
    </view>

    <view class="category-section">
      <view class="category-title">
        <text class="icon">🥣</text>
        <text>汤品 ({{dishes.filter(d => d.category === 'soup').length}})</text>
      </view>
      <view class="dish-grid">
        <view class="dish-card" wx:for="{{dishes}}" wx:key="id" wx:if="{{item.category === 'soup'}}">
          <text class="dish-name">{{item.name}}</text>
          <text class="dish-tag" wx:if="{{item.is_preset}}">预设</text>
          <text class="dish-tag custom" wx:else>自定义</text>
        </view>
      </view>
      <view class="empty-hint" wx:if="{{dishes.filter(d => d.category === 'soup').length === 0}}">
        <text>暂无汤品</text>
      </view>
    </view>
  </view>

  <view class="modal" wx:if="{{showAddDialog}}">
    <view class="modal-mask" bindtap="hideAddForm"></view>
    <view class="modal-content">
      <view class="modal-title">添加自定义菜品</view>
      
      <view class="form-item">
        <text class="label">菜品名称</text>
        <input class="input" placeholder="请输入菜品名称" value="{{newDishName}}" bindinput="onNameInput" />
      </view>

      <view class="form-item">
        <text class="label">分类</text>
        <radio-group bindchange="onCategoryChange">
          <label class="radio-item">
            <radio value="dish" checked="{{newDishCategory === 'dish'}}" />
            <text>菜品</text>
          </label>
          <label class="radio-item">
            <radio value="soup" checked="{{newDishCategory === 'soup'}}" />
            <text>汤品</text>
          </label>
        </radio-group>
      </view>

      <view class="modal-buttons">
        <button class="btn btn-cancel" bindtap="hideAddForm">取消</button>
        <button class="btn btn-confirm" bindtap="submitNewDish">确定</button>
      </view>
    </view>
  </view>
</view>
