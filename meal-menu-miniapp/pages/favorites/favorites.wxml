<view class="container">
  <view class="favorites-list" wx:if="{{favorites.length > 0}}">
    <view class="favorite-card" wx:for="{{favorites}}" wx:key="id">
      <view class="card-header">
        <text class="date">{{item.created_at}}</text>
        <text class="delete-btn" bindtap="deleteFavorite" data-id="{{item.id}}">删除</text>
      </view>
      
      <view class="menu-content">
        <view class="section">
          <view class="section-title">
            <text class="icon">🍽️</text>
            <text>菜品</text>
          </view>
          <view class="dish-list">
            <view class="dish-item" wx:for="{{item.menu_data.dishes}}" wx:key="id" wx:for-item="dish">
              <text class="dish-number">{{index + 1}}</text>
              <text class="dish-name">{{dish.name}}</text>
            </view>
          </view>
        </view>

        <view class="section">
          <view class="section-title">
            <text class="icon">🥣</text>
            <text>汤品</text>
          </view>
          <view class="soup-item">
            <text class="dish-name">{{item.menu_data.soup.name}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="empty" wx:else>
    <text class="empty-icon">📋</text>
    <text class="empty-text">还没有收藏任何菜单</text>
    <text class="empty-hint">去首页生成菜单并收藏吧</text>
  </view>
</view>
