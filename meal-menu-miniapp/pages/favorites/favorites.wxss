.container {
  padding: 30rpx;
  min-height: 100vh;
}

.favorites-list {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.favorite-card {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 20rpx;
  margin-bottom: 20rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.date {
  font-size: 24rpx;
  color: #999;
}

.delete-btn {
  font-size: 26rpx;
  color: #f44336;
  padding: 8rpx 20rpx;
  background: #ffebee;
  border-radius: 30rpx;
}

.menu-content {
  margin-top: 20rpx;
}

.section {
  margin-bottom: 30rpx;
}

.section:last-child {
  margin-bottom: 0;
}

.section-title {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 15rpx;
}

.icon {
  font-size: 32rpx;
  margin-right: 8rpx;
}

.dish-list {
  padding: 5rpx 0;
}

.dish-item {
  display: flex;
  align-items: center;
  padding: 15rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.dish-item:last-child {
  border-bottom: none;
}

.dish-number {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  background: #4CAF50;
  color: white;
  border-radius: 50%;
  font-size: 22rpx;
  font-weight: bold;
  margin-right: 15rpx;
}

.dish-name {
  font-size: 28rpx;
  color: #333;
}

.soup-item {
  padding: 15rpx 0;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 150rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #999;
}
